# Makefile.cross - Cross-compilation Makefile for YouTubeCacher (llvm-mingw)
#
# Usage: make -f Makefile.cross [target]
#
# Builds the same targets as Makefile, with the llvm-mingw cross toolchain
# instead of MSYS2's. llvm-mingw links against UCRT, so the 64 and ucrt64
# variants use the same compiler here. The default target builds release
# executables for all three architectures.

# Where the llvm-mingw toolchain lives. $(HOME) rather than ~: make does not
# expand ~ in a variable, so a literal ~ on PATH finds nothing.
TOOLCHAIN_BIN ?= $(HOME)/llvm-mingw/bin
export PATH := $(TOOLCHAIN_BIN):$(PATH)

CC32 ?= i686-w64-mingw32-gcc
RC32 ?= i686-w64-mingw32-windres
CC64 ?= x86_64-w64-mingw32-gcc
RC64 ?= x86_64-w64-mingw32-windres
CCUCRT64 ?= x86_64-w64-mingw32-gcc
RCUCRT64 ?= x86_64-w64-mingw32-windres
CCARM64 ?= aarch64-w64-mingw32-gcc
RCARM64 ?= aarch64-w64-mingw32-windres

DEFAULT_TARGET ?= release

include Makefile
